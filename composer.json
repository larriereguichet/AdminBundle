{
    "name": "lag/adminbundle",
    "type": "symfony-bundle",
    "description": "Generic admin bundle for Symfony2 from L'arrière-guichet",
    "keywords": [
        "Admin",
        "Backoffice",
        "Symfony",
        "Generic"
    ],
    "homepage": "https://github.com/larriereguichet/AdminBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "JohnKrovitch",
            "email": "arnaudfrezet@gmail.com"
        },
        {
            "name": "JohanDufour",
            "email": "johan.dufour@gmail.com"
        },
        {
            "name": "VincentChalnot",
            "email": "vincent.chalnot@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "doctrine/annotations": "^2.0",
        "johnkrovitch/orm-pack": "^3.1",
        "knplabs/knp-menu-bundle": "^3.2",
        "league/flysystem-bundle": "^3.2",
        "nadar/quill-delta-parser": "^3.4",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/error-handler": "^7.0 || ^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0",
        "symfony/expression-language": "^7.1 || ^8.0",
        "symfony/form": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/security-bundle": "^7.0 || ^8.0",
        "symfony/serializer": "^7.0 || ^8.0",
        "symfony/translation": "^7.0 || ^8.0",
        "symfony/twig-bundle": "^7.0 || ^8.0",
        "symfony/uid": "^7.1 || ^8.0",
        "symfony/ux-autocomplete": "^2.17 || ^3.0",
        "symfony/ux-live-component": "^2.17 || ^3.0",
        "symfony/ux-twig-component": "^2.13 || ^3.0",
        "symfony/validator": "^7.1 || ^8.0",
        "twig/extra-bundle": "^3.0",
        "twig/html-extra": "^3.12",
        "twig/intl-extra": "^3.3",
        "twig/string-extra": "^3.4",
        "twig/twig": "^3.15"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.13",
        "liip/imagine-bundle": "^2.13",
        "nyholm/symfony-bundle-test": "^3.0",
        "php-parallel-lint/php-var-dump-check": "^0.5",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.3",
        "rector/rector": "^2.0",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^7.0 || ^8.0",
        "symfony/css-selector": "^7.0 || ^8.0",
        "symfony/debug-bundle": "^7.1 || ^8.0",
        "symfony/dotenv": "^7.1 || ^8.0",
        "symfony/monolog-bundle": "^4.0",
        "symfony/object-mapper": "^7.1 || ^8.0",
        "symfony/runtime": "^7.1 || ^8.0",
        "symfony/var-dumper": "^7.0 || ^8.0",
        "symfony/web-profiler-bundle": "^7.0 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/workflow": "^7.1 || ^8.0",
        "symplify/config-transformer": "^12.3",
        "zenstruck/foundry": "^2.2"
    },
    "suggest": {
        "symfony/object-mapper": "Enables mapper-based input/output transformation (MappingProvider and MappingProcessor)"
    },
    "autoload": {
        "psr-4": {
            "LAG\\AdminBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LAG\\AdminBundle\\Tests\\Unit\\": "tests/unit/",
            "LAG\\AdminBundle\\Tests\\Functional\\": "tests/functional/",
            "LAG\\AdminBundle\\Tests\\Application\\": "tests/app/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    }
}
