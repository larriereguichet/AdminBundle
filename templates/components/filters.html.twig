<div class="row">
    <div class="col-12">
        <a href="#filters"
           data-bs-toggle="collapse"
           role="button"
           aria-expanded="false"
           aria-controls="filters">
            {{ 'lag_admin.ui.show_filters'|trans({}, 'admin') }}
        </a>

        <div id="filters" class="collapse">
            <h4>{{ 'lag_admin.ui.filter'|trans({}, 'admin') }}</h4>
            {{ form_start(form) }}

            {{ form_row(form) }}

            <div class="text-right btn-group" role="group">
                <a href="{{ app.request.pathInfo }}"
                   class="btn btn-outline-secondary">
                    <i class="fas fa-eraser"></i>
                    {{ 'lag_admin.ui.reset'|trans({}, 'admin') }}
                </a>

                <button type="submit"
                        class="btn btn-success">
                    {{ 'lag_admin.ui.filter'|trans({}, 'admin') }}
                    <i class="fas fa-filter"></i>
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
