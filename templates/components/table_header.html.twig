{% trans_default_domain header.translationDomain %}
{% if header.sortable %}
    <a href="{{ lag_admin_sort_url(header.name, header.sortParameter, header.orderParameter, header.sort, header.order) }}"
       class="text-dark">
        {{ header.label|trans }}

        {% if header.sort == header.name %}
            {% if header.order|lower == 'asc' %}
                <i class="bi bi-arrow-up sort-icon sort-asc"></i>
            {% else %}
                <i class="bi bi-arrow-down sort-icon sort-desc"></i>
            {% endif %}
        {% endif %}
    </a>
{% elseif header.label %}
    {{ header.label|trans }}
{% endif %}
