{% extends '@LAGAdmin/components/grid.html.twig' %}

{% block rows %}
    <table class="admin-table table">
        {% block table_header %}
            <thead>
            <tr {{ grid.headers.attributes }}>
                {% if grid.batchEnabled %}
                    <th class="admin-batch-check-col">
                        <input type="checkbox" class="form-check-input admin-batch-check-all" aria-label="{{ 'lag_admin.batch.select_all'|trans({}, 'admin') }}">
                    </th>
                {% endif %}
                {% for header in grid.headers %}
                    <th {{ header.attributes }}>
                        <twig:lag_admin:table_header header="{{ header }}"></twig:lag_admin:table_header>
                    </th>
                {% endfor %}
            </tr>
            </thead>
        {% endblock %}

        {% block body %}
            <tbody>
            {% for row in grid.rows %}
                <tr {{ row.attributes }}>
                    {% if grid.batchEnabled %}
                        <td class="admin-batch-check-col">
                            <input type="checkbox" name="batch_ids[]" value="{{ attribute(row.data, grid.batchIdentifier) }}" class="form-check-input admin-batch-check-row">
                        </td>
                    {% endif %}
                    {% for cell in row.cells %}
                        <td {{ cell.attributes }}>
                            <twig:lag_admin:cell cell="{{ cell }}" data="{{ cell.data }}"></twig:lag_admin:cell>
                        </td>
                    {% endfor %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ grid.headers|length + (grid.batchEnabled ? 1 : 0) }}">
                        {% if grid.emptyMessage %}
                            {{ grid.emptyMessage|trans({}, grid.translationDomain) }}
                        {% else %}
                            {{ 'lag_admin.ui.no_record'|trans({}, 'admin') }}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        {% endblock %}
    </table>
{% endblock %}
