{# the grid attributes are merged into the component attributes by AttributeComponentRenderListener #}
<div {{ attributes.defaults({class: 'admin-grid'}) }}>
    {% block title %}
        {% if grid.title %}
            {% include '@LAGAdmin/components/grid_title.html.twig' with {title: grid.title} only %}
        {% endif %}
    {% endblock %}

    {% block header %}{% endblock %}

    {% block rows %}
        {% for row in grid.rows %}
            <twig:lag_admin:row row="{{ row }}" />
        {% else %}
            {% block empty %}{% endblock %}
        {% endfor %}
    {% endblock %}

    {% block footer %}{% endblock %}
</div>
