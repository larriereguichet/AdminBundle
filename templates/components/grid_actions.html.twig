{% if actions|length > 0 %}
    <div {{ attributes.defaults({'class': 'row'})}}>
        <div class="col text-end">
            <div class="btn-group"
                 role="group"
                 aria-label="Collection actions">
                {% for action in actions %}
                    <twig:lag_admin:grid_cell
                        cell="{{ action }}"
                        data="{{ action.data }}"
                        class="btn btn-outline-primary"></twig:lag_admin:grid_cell>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}
