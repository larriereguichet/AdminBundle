{% trans_default_domain property.translationDomain %}
<a href="{{ data }}" {{ attributes.defaults({class: 'btn'}) }}>
    {% if property.icon %}<i class="bi bi-{{ property.icon }}"></i>{% endif %}

    {% if property.translatable %}
        {{ property.label|trans }}
    {% else %}
        {{ property.label }}
    {% endif %}
</a>
