{% extends '@LAGAdmin/resources/operation.html.twig' %}

{% set grid = grid|default(false) %}

{% block content %}
    <div class="admin-index admin-{{ resource.shortName }}">
        {% block collection_links %}
            <twig:lag_admin:links links="{{ operation.collectionLinks }}" />
        {% endblock %}

        {% block filters %}
            {# TODO #}
{#            {% if filterForm %}<twig:lag_admin:filters form="{{ filterForm }}"></twig:lag_admin:filters>{% endif %}#}
        {% endblock %}

        {% block grid %}
            {% if grid %}
                {% if batchForm is defined and batchForm %}
                    {{ form_start(batchForm, {'action': app.request.uri, 'method': 'POST', 'attr': {'class': 'admin-batch-form'}}) }}
                {% endif %}

                <twig:lag_admin:grid
                        grid="{{ grid }}"
                        data="{{ data }}" />

                {% if batchForm is defined and batchForm %}
                    {% include '@LAGAdmin/resources/index/_batch.html.twig' with {'batchForm': batchForm} %}
                    {{ form_end(batchForm) }}
                {% endif %}
            {% endif %}
        {% endblock %}

        {% block pagination %}
            {% if lag_admin_is_pager(data) and data.haveToPaginate %}
                <div class="admin-pagination my-4">
                    <div class="pagination justify-content-center">
                        {{ pagerfanta(data, {
                            page: data.currentPage,
                            routeName: app.request.attributes.get('_route'),
                            routeParams: app.request.attributes.get('_route_params'),
                        }) }}
                    </div>
                </div>
            {% endif %}
        {% endblock %}

        {% block bottom_extra_content %}{% endblock %}
    </div>
{% endblock %}

